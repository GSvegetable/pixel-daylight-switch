{
  "name": "pixel-daylight-switch-gsvegetable",
  "version": "2.2.0",
  "description": "A draggable pixel-art day/night switch with a living world inside a refractive glass lens.",
  "keywords": [
    "pixel-art",
    "day-night",
    "toggle",
    "switch",
    "canvas",
    "webgl",
    "ui-component",
    "vanilla-js",
    "capacitor",
    "android",
    "ios"
  ],
  "author": "GSvegetable",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/GSvegetable/pixel-daylight-switch.git"
  },
  "homepage": "https://github.com/GSvegetable/pixel-daylight-switch#readme",
  "bugs": {
    "url": "https://github.com/GSvegetable/pixel-daylight-switch/issues"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "browser": "./app.js",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./app.js": "./app.js",
    "./package.json": "./package.json"
  },
  "files": [
    "app.js",
    "index.cjs",
    "index.mjs",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "sideEffects": [
    "./app.js"
  ],
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node tests/package-smoke.cjs && node tests/mobile-smoke.cjs",
    "test:browser": "playwright test",
    "mobile:prepare": "node scripts/prepare-mobile.cjs",
    "mobile:android": "npm run mobile:prepare && cap sync android && node scripts/set-android-version.cjs android/app/build.gradle",
    "mobile:ios": "npm run mobile:prepare && cap sync ios",
    "mobile:android:init": "npm run mobile:prepare && cap add android && node scripts/set-android-version.cjs android/app/build.gradle",
    "mobile:ios:init": "npm run mobile:prepare && cap add ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/ios": "8.6.0"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsvegetable.github.io/pixel-daylight-switch/schemas/scene-manifest.v2.schema.json",
  "title": "Pixel Daylight Switch Scene Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "author",
    "license",
    "canvas",
    "pixels",
    "palettes",
    "timeCycle",
    "assets",
    "layers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,62}[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 112
        }
      }
    },
    "pixels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 112,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 192,
        "pattern": "^[\\x20-\\x7E]+$"
      }
    },
    "palettes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "additionalProperties": {
        "type": "object",
        "maxProperties": 64,
        "propertyNames": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "pattern": "^[\\u0020-\\u007E]$"
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        }
      }
    },
    "timeCycle": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "palette"
        ],
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "palette": {
            "type": "string"
          }
        }
      },
      "maxItems": 48
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "width",
          "height",
          "pixels"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 192
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 112
          },
          "pixels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 112,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192,
              "pattern": "^[\\x20-\\x7E]+$"
            }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "asset",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,47}$"
          },
          "asset": {
            "type": "string"
          },
          "x": {
            "type": "integer",
            "minimum": -192,
            "maximum": 192
          },
          "y": {
            "type": "integer",
            "minimum": -112,
            "maximum": 112
          },
          "animation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "axis",
              "speed",
              "distance"
            ],
            "properties": {
              "type": {
                "enum": [
                  "drift",
                  "bob"
                ]
              },
              "axis": {
                "enum": [
                  "x",
                  "y"
                ]
              },
              "speed": {
                "type": "number",
                "minimum": 0,
                "maximum": 4
              },
              "distance": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "phase": {
                "type": "number",
                "minimum": 0,
                "maximum": 6.2832
              }
            }
          }
        }
      }
    }
  }
}

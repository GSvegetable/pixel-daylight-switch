{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsvegetable.github.io/pixel-daylight-switch/schemas/scene-manifest.v1.json",
  "title": "Pixel Daylight Switch Scene Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "author", "license", "canvas", "pixels", "palettes", "timeCycle"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,62}[a-z0-9]$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "type": "string", "minLength": 1, "maxLength": 64 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 112 }
      }
    },
    "pixels": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "palettes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "minLength": 1, "maxLength": 1 },
        "additionalProperties": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" }
      }
    },
    "timeCycle": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "palette"],
        "properties": {
          "at": { "type": "number", "minimum": 0, "maximum": 24 },
          "palette": { "type": "string" }
        }
      }
    }
  }
}
